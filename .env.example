# ---- core ----
SECRET_KEY=change-me-to-a-long-random-string
ENV=development
WEB_ORIGIN=http://localhost:3000
# Public base URL users hit. The web app proxies /api + /mcp to the API container,
# so everything is one origin and the session cookie is first-party.
API_BASE_URL=http://localhost:3000

# ---- Google OAuth (https://console.cloud.google.com/apis/credentials) ----
# Authorized redirect URI must be: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- database ----
POSTGRES_USER=insightforge
POSTGRES_PASSWORD=insightforge
POSTGRES_DB=insightforge
DATABASE_URL=postgresql+psycopg://insightforge:insightforge@postgres:5432/insightforge

# ---- redis / celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ---- object storage (MinIO / S3) ----
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=insightforge
S3_REGION=us-east-1

# ---- limits ----
UPLOAD_MAX_BYTES=104857600
INLINE_MAX_BYTES=5242880
RAW_ROWS_CAP=5000

# ---- web ----
# Leave empty: the browser calls the API same-origin through the Next.js proxy.
# Set a full URL only if you serve the API on a separate public host.
NEXT_PUBLIC_API_BASE_URL=
